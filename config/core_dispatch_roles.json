        {
          "address": "0xA239",
          "symbol": "World3_PlayerState_Frozen",
          "role": "state 0 performs no update"
        },
        {
          "address": "0xA335",
          "symbol": "World3_PlayerState_ControlledMovement",
          "role": "state 1 updates controlled movement and firing"
        },
        {
          "address": "0xA33C",
          "symbol": "World3_PlayerState_AlternateMovement",
          "role": "state 2 updates alternate movement and firing"
        },
        {
          "address": "0xA2E9",
          "symbol": "World3_PlayerState_DamageRecovery",
          "role": "state 3 runs timed knockback then returns to state 1"
        },
        {
          "address": "0xA23A",
          "symbol": "World3_PlayerState_Dying",
          "role": "state 4 animates death and resolves life loss"
        }
