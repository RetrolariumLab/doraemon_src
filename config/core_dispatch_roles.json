          "role": "upload second tile-column pair and eight attributes"
        },
        {
          "address": "0x8641",
          "symbol": "World2_UploadHorizontalTileRowsB",
          "role": "upload second pair of sixteen-tile rows"
        },
        {
          "address": "0x8660",
          "symbol": "World2_ReadAndMergeHorizontalAttributes",
          "role": "read and merge eight attributes for sixteen metatiles"
        },
        {
          "address": "0x86C9",
          "symbol": "World2_UploadHorizontalTileRowsA",
          "role": "upload first pair of sixteen-tile rows"
        },
        {
          "address": "0x86EB",
          "symbol": "World2_UploadHorizontalAttributes",
          "role": "upload eight merged attribute bytes"
        },
        {
          "address": "0x8747",
          "symbol": "World2_ApplyPendingBackgroundPalette",
          "role": "select and upload pending background palette"
