schema = "retrolarium.game"
schema_version = 1

# Opened by Retrolarium Studio: pick a version, and the studio checks its ROM,
# splits the assets and keeps your edits in hack/<version>/ (not tracked).

[game]
id = "doraemon"
name = "Doraemon"
platform = "nes"
profile = "doraemon.v1"

[[revisions]]
id = "original"
label = "Japan · original"
rom = "Doraemon (J) (PRG0) [!].nes"

[[revisions]]
id = "rev_a"
label = "Japan · Rev A"
rom = "Doraemon (Japan) (Rev A).nes"

[split]
revision = "original"
command = ["scripts/run.py", "build.project", "split", "--image", "{rom}", "--manifest", "assets/manifest.json", "--output-dir", "assets/generated"]
check = ["scripts/run.py", "build.project", "require", "--path", "assets/generated/prg/doraemon.prg", "--hint", "split"]
